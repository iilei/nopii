root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{tmpl,json,md,toml}]
indent_size = 1

[{*.go,go.mod}]
indent_style = tab
indent_size = unset

[*.{yaml,yml,ps1,nuspec}]
indent_size = 2

[*.md]
indent_size = unset

[Makefile]
indent_style = tab
indent_size = unset
